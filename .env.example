# --- Postgres ---
POSTGRES_USER=formula
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=formula
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- API ---
# Внутренний URL БД для API (собирается из POSTGRES_* при пустом значении)
DATABASE_URL=
API_CORS_ORIGINS=http://localhost:3000
# Провайдер данных для расписания/результатов: jolpica (бесплатный, без ключа)
DATA_PROVIDER=jolpica
# Лимит запросов к провайдеру (token bucket)
PROVIDER_RATE_PER_SEC=4
PROVIDER_RATE_BURST=8
# Сколько часов кэш сезона считается свежим, прежде чем перезапросить
SCHEDULE_TTL_HOURS=12

# --- Домен и HTTPS (reverse-proxy Caddy) ---
# Домен сайта. Caddy автоматически получит TLS-сертификат Let's Encrypt для него
# (нужны открытые порты 80/443 и DNS, указывающий на этот сервер).
# Локально можно оставить localhost — тогда Caddy отдаёт по http без сертификата.
SITE_DOMAIN=localhost

# --- Realtime (Фаза 3: Centrifugo) ---
# Общий ключ HTTP API Centrifugo (api публикует тайминг; смените в проде)
CENTRIFUGO_API_KEY=dev_centrifugo_api_key
# Включить демо-поток тайминга (работает, если LIVE_SOURCE не задан)
LIVE_DEMO=true
# Источник тайминга. Пусто = демо. "openf1_replay" = проигрывать прошедшую гонку
# из OpenF1 (настоящие позиции/интервалы/шины + лента рейс-контроля на русском).
LIVE_SOURCE=
# session_key гонки OpenF1 для реплея. Примеры 2024: 9606 Сингапур, 9523 Монако,
# 9662 Абу-Даби. Найти другие: https://api.openf1.org/v1/sessions?year=2024&session_name=Race
OPENF1_SESSION_KEY=9606
# Во сколько раз ускорять гоночное время в реплее (60 = 2-часовая гонка за ~2 мин)
OPENF1_REPLAY_SPEED=60
# Публичный WebSocket-URL Centrifugo для браузера.
# С reverse-proxy (прод, https): wss://<SITE_DOMAIN>/connection/websocket
# Без proxy напрямую (локально/отладка):  ws://localhost:8001/connection/websocket
NEXT_PUBLIC_CENTRIFUGO_URL=ws://localhost:8001/connection/websocket

# Список разрешённых origin'ов Centrifugo — в infra/centrifugo/config.json
# (allowed_origins). При новом домене добавь его туда и: docker compose restart centrifugo

# --- Web ---
# URL API, который использует Next.js на СЕРВЕРЕ (внутри docker-сети)
API_INTERNAL_URL=http://api:8000
# Публичный URL API для браузера (для клиентских запросов; в MVP не обязателен)
NEXT_PUBLIC_API_URL=http://localhost:8000
