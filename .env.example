# --- Postgres ---
POSTGRES_USER=formula
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=formula
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- API ---
# Внутренний URL БД для API (собирается из POSTGRES_* при пустом значении)
DATABASE_URL=
API_CORS_ORIGINS=http://localhost:3000
# Провайдер данных для расписания/результатов: jolpica (бесплатный, без ключа)
DATA_PROVIDER=jolpica
# Лимит запросов к провайдеру (token bucket)
PROVIDER_RATE_PER_SEC=4
PROVIDER_RATE_BURST=8
# Сколько часов кэш сезона считается свежим, прежде чем перезапросить
SCHEDULE_TTL_HOURS=12

# --- Realtime (Фаза 3: Centrifugo) ---
# Общий ключ HTTP API Centrifugo (api публикует тайминг; смените в проде)
CENTRIFUGO_API_KEY=dev_centrifugo_api_key
# Включить демо-поток тайминга, пока не подключён реальный поток (OpenF1)
LIVE_DEMO=true
# Публичный WebSocket-URL Centrifugo для браузера.
# Локально: ws://localhost:8001/connection/websocket
# На VPS (http): ws://<host>:8001/connection/websocket
# На VPS (https): wss://<домен>/connection/websocket — через reverse-proxy (см. ниже)
NEXT_PUBLIC_CENTRIFUGO_URL=ws://localhost:8001/connection/websocket

# Список разрешённых origin'ов Centrifugo задаётся в infra/centrifugo/config.json
# (allowed_origins). При новом домене/HTTPS добавь его туда и перезапусти:
#   docker compose restart centrifugo
#
# HTTPS-прод: браузер на https-странице умеет только wss://, поэтому Centrifugo
# прячем за reverse-proxy на том же домене. Пример для Caddy:
#   race.live {
#     handle /connection/* { reverse_proxy centrifugo:8000 }
#     handle { reverse_proxy web:3000 }
#   }
# Для nginx: proxy_pass на :8001 для /connection/ + заголовки Upgrade/Connection.

# --- Web ---
# URL API, который использует Next.js на СЕРВЕРЕ (внутри docker-сети)
API_INTERNAL_URL=http://api:8000
# Публичный URL API для браузера (для клиентских запросов; в MVP не обязателен)
NEXT_PUBLIC_API_URL=http://localhost:8000
