{
  "health": true,
  "allowed_origins": [
    "http://localhost:3000",
    "http://tensory.ulya.space:3000",
    "https://tensory.ulya.space",
    "https://race.live",
    "https://www.race.live"
  ],
  "allow_anonymous_connect_without_token": true,
  "namespaces": [
    {
      "name": "timing",
      "allow_subscribe_for_client": true,
      "allow_subscribe_for_anonymous": true,
      "history_size": 1,
      "history_ttl": "60s",
      "force_recovery": true
    },
    {
      "name": "reactions",
      "allow_subscribe_for_client": true,
      "allow_subscribe_for_anonymous": true,
      "presence": true,
      "allow_presence_for_subscriber": true,
      "allow_presence_for_anonymous": true
    }
  ]
}
